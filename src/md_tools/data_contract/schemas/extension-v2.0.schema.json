{
  "$defs": {
    "ExtensionTarget": {
      "additionalProperties": false,
      "description": "The dataset and component whose simulation is being continued.",
      "properties": {
        "component": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*",
          "title": "Component",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "[a-z0-9][a-z0-9-]*",
          "title": "Dataset Id",
          "type": "string"
        },
        "original_length_ns": {
          "exclusiveMinimum": 0,
          "title": "Original Length Ns",
          "type": "number"
        },
        "source_checkpoint": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source Checkpoint",
          "type": "string"
        },
        "source_checkpoint_copied": {
          "default": false,
          "title": "Source Checkpoint Copied",
          "type": "boolean"
        },
        "source_checkpoint_sha256": {
          "pattern": "[0-9a-f]{64}",
          "title": "Source Checkpoint Sha256",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "component",
        "source_checkpoint",
        "source_checkpoint_sha256",
        "original_length_ns"
      ],
      "title": "ExtensionTarget",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "description": "A scientific identity, not a machine login.\n\nPer-run operator and host details belong in the run records, where they are useful for\ndebugging. A dataset manifest travels; it carries who is answerable for the science.",
      "properties": {
        "affiliation": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affiliation"
        },
        "name": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "orcid": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        },
        "person_id": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "[a-z0-9][a-z0-9-]*",
          "title": "Person Id",
          "type": "string"
        }
      },
      "required": [
        "person_id",
        "name"
      ],
      "title": "Person",
      "type": "object"
    },
    "SourceRepository": {
      "additionalProperties": false,
      "description": "A repository pinned at an exact commit.\n\nBoth fields are required together. Naming a repository without a commit records where to look\nbut not what ran, which is the failure this contract exists to prevent.",
      "properties": {
        "commit": {
          "pattern": "[0-9a-f]{40}",
          "title": "Commit",
          "type": "string"
        },
        "repository": {
          "maxLength": 2048,
          "pattern": "https://[^\\s]+",
          "title": "Repository",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "title": "SourceRepository",
      "type": "object"
    }
  },
  "$id": "https://github.com/csy0000/MD-tools/schemas/extension-v2.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One continuation request and its outcome, beside the `dataset.yaml` it belongs to.\n\nTimestamp semantics by status:\n\n    requested   no outcome fields at all\n    running     started_at set, completed_at absent\n    complete    started_at, completed_at and final_length_ns all set\n    failed      optional; completed_at means WHEN THE ATTEMPT STOPPED and requires\n    abandoned   started_at. final_length_ns records partial output if any exists.",
  "properties": {
    "additional_length_ns": {
      "exclusiveMinimum": 0,
      "title": "Additional Length Ns",
      "type": "number"
    },
    "combined_length_ns": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Combined Length Ns"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "[a-z0-9][a-z0-9-]*",
      "title": "Dataset Id",
      "type": "string"
    },
    "final_length_ns": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Length Ns"
    },
    "generation": {
      "$ref": "#/$defs/SourceRepository"
    },
    "mode": {
      "enum": [
        "in-place",
        "new-dataset"
      ],
      "title": "Mode",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "output_component": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*",
      "title": "Output Component",
      "type": "string"
    },
    "parent_links": {
      "items": {
        "type": "string"
      },
      "title": "Parent Links",
      "type": "array"
    },
    "reason": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "$ref": "#/$defs/Person"
    },
    "restart_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Restart Step"
    },
    "restart_time_ps": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Restart Time Ps"
    },
    "schema_version": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "requested",
        "running",
        "complete",
        "failed",
        "abandoned"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ExtensionTarget"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "dataset_id",
    "target",
    "output_component",
    "additional_length_ns",
    "reason",
    "requested_by",
    "requested_at",
    "status",
    "generation"
  ],
  "title": "MD-data extension record",
  "type": "object"
}
