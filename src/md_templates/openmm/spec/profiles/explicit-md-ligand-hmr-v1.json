{
  "profile_id": "explicit-md-ligand-hmr-v1",
  "profile_schema_version": 6,
  "description": "Ligand route: Sage/OpenFF 2.2 + AM1-BCC with TIP3P water. Sage's Lennard-Jones parameters were refit against condensed-phase data conditioned on TIP3P, so TIP3P is its validated partner; OPC is ff19SB's. Supersedes the v1 TIP3P-FB pairing.  PERFORMANCE VARIANT: hydrogen mass repartitioning (3.024 Da on solute hydrogens) with a 4 fs timestep, roughly halving wall-clock per nanosecond. Opt in by naming this profile; it is never selected automatically. HMR moves mass from heavy atoms into the hydrogens they are bonded to; it changes the mass distribution, not the potential. Charges are the standard AM1-BCC default: HMR changes integration, not chemistry, and the two opt-ins are independent.",
  "route": "smiles",
  "method": "md",
  "is_default": false,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": "amber19/tip3p.xml"
      },
      "solvation": {
        "water_model": "tip3p",
        "box_shape": "dodecahedron",
        "padding": "2.0 nm",
        "padding_semantics": "openmm",
        "ionic_strength_molar": 0.15,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "1.0 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 6,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "staged",
        "minimize_max_iterations": 1000,
        "npt_free": "500 ps",
        "seed": null,
        "nvt": "250 ps",
        "npt": "250 ps"
      },
      "production": {
        "method": "md",
        "duration_per_segment": "5 ns",
        "scale_factor": 1.0,
        "seed": null
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "100 ps",
        "solute": "10 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  },
  "performance_variant": true
}
