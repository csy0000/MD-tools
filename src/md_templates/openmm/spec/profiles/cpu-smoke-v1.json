{
  "profile_id": "cpu-smoke-v1",
  "profile_schema_version": 3,
  "description": "Tiny CPU smoke: proves execution, no scientific meaning",
  "route": "smiles",
  "method": "rest2",
  "is_default": false,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": "amber19/tip3pfb.xml"
      },
      "solvation": {
        "water_model": "tip3p",
        "box_shape": "cube",
        "padding": "1.2 nm",
        "padding_semantics": "solute-image-gap",
        "ionic_strength_molar": 0.0,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "0.7 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 3,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "simple",
        "minimize_max_iterations": 200,
        "timestep": "1 fs",
        "nvt": "2 ps",
        "npt": "2 ps",
        "npt_free": "2 ps",
        "box_average_last": "1 ps",
        "seed": null
      },
      "production": {
        "method": "rest2",
        "enhanced_region": {
          "type": "solute"
        },
        "tau_ladder": {
          "minimum": 0.0,
          "maximum": 0.5,
          "count": 3,
          "interpolation": "linear"
        },
        "exchange": {
          "n_exchange_per_segment": 2,
          "exchange_interval": "0.5 ps"
        },
        "omega_exclusion": {
          "enabled": true,
          "definition": "peptide_omega",
          "proline_like_residues": [
            "PRO"
          ],
          "max_proline_ring_size": 7
        },
        "relaxation": "1 ps",
        "seed": null
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "0.5 ps",
        "solute": "0.5 ps",
        "state": "0.5 ps",
        "checkpoint": "0.5 ps"
      }
    }
  }
}
