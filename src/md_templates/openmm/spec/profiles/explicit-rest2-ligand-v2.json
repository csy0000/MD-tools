{
  "profile_id": "explicit-rest2-ligand-v2",
  "profile_schema_version": 5,
  "description": "Ligand route: Sage/OpenFF 2.2 + AM1-BCC with TIP3P water. Sage's Lennard-Jones parameters were refit against condensed-phase data conditioned on TIP3P, so TIP3P is its validated partner; OPC is ff19SB's. Supersedes the v1 TIP3P-FB pairing.",
  "route": "smiles",
  "method": "rest2",
  "is_default": true,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": "amber19/tip3p.xml"
      },
      "solvation": {
        "water_model": "tip3p",
        "box_shape": "dodecahedron",
        "padding": "1.2 nm",
        "padding_semantics": "solute-image-gap",
        "ionic_strength_molar": 0.15,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "1.0 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 5,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "staged",
        "minimize_max_iterations": 1000,
        "npt_free": "10 ps",
        "seed": null,
        "nvt": "10 ps",
        "npt": "10 ps"
      },
      "production": {
        "method": "rest2",
        "enhanced_region": {
          "type": "solute"
        },
        "tau_ladder": {
          "minimum": 0.0,
          "maximum": 0.5,
          "count": 10,
          "interpolation": "linear"
        },
        "omega_exclusion": {
          "enabled": true,
          "definition": "peptide_omega",
          "proline_like_residues": [
            "PRO"
          ],
          "max_proline_ring_size": 7
        },
        "relaxation": "10 ps",
        "seed": null,
        "duration_per_segment": "5 ns",
        "exchange": {
          "number_of_exchanges_per_segment": 1000
        }
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "100 ps",
        "solute": "10 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  }
}
