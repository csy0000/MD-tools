{
  "profile_id": "explicit-md-peptide-v2",
  "profile_schema_version": 5,
  "description": "Explicit-water conventional MD, peptide/PDB route, ff19SB/OPC \u2014 the active default. ff19SB was parameterised against OPC, which is why OPC rather than TIP3P-FB is the default here.",
  "route": "pdb",
  "method": "md",
  "is_default": true,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": null,
        "charge_method": null,
        "protein": "amber19/protein.ff19SB.xml",
        "water": "amber19/opc.xml"
      },
      "solvation": {
        "water_model": "opc",
        "box_shape": "dodecahedron",
        "padding": "1.2 nm",
        "padding_semantics": "solute-image-gap",
        "ionic_strength_molar": 0.15,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "1.0 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 5,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "staged",
        "minimize_max_iterations": 1000,
        "npt_free": "10 ps",
        "seed": null,
        "nvt": "10 ps",
        "npt": "10 ps"
      },
      "production": {
        "method": "md",
        "duration_per_segment": "5 ns",
        "scale_factor": 1.0,
        "seed": null
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "100 ps",
        "solute": "10 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  }
}
