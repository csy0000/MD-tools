        "relaxation": "10 ps",
        "seed": null,
        "duration_per_segment": "2 ns",
        "exchange": {
          "number_of_exchanges_per_segment": 200
        }
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "10 ps",
        "solute": "2 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
