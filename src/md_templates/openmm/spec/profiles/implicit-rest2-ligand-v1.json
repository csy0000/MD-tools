{
  "profile_id": "implicit-rest2-ligand-v1",
  "profile_schema_version": 5,
  "description": "Implicit-solvent GBn2/mbondi3 REST2, ligand/SMILES route",
  "route": "smiles",
  "method": "rest2",
  "is_default": false,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": null
      },
      "nonbonded": {
        "method": "NoCutoff",
        "cutoff": null,
        "switch_distance": null,
        "use_dispersion_correction": false,
        "ewald_error_tolerance": null,
        "minimum_image_margin": null
      },
      "constraints": "HBonds",
      "rigid_water": false,
      "hydrogen_mass": null,
      "hmr_scope": "none",
      "remove_cm_motion": true,
      "implicit": {
        "model": "GBn2",
        "radii": "mbondi3"
      }
    },
    "protocol": {
      "schema_version": 4,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "2 fs",
