{
  "profile_id": "implicit-rest2-ligand-hmr-v1",
  "profile_schema_version": 6,
  "description": "Implicit-solvent GBn2/mbondi3 REST2, ligand/SMILES route  PERFORMANCE VARIANT: hydrogen mass repartitioning (3.024 Da on solute hydrogens) with a 4 fs timestep, roughly halving wall-clock per nanosecond. Opt in by naming this profile; it is never selected automatically. HMR moves mass from heavy atoms into the hydrogens they are bonded to; it changes the mass distribution, not the potential. Charges are the standard AM1-BCC default: HMR changes integration, not chemistry, and the two opt-ins are independent.",
  "route": "smiles",
  "method": "rest2",
  "is_default": false,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": null
      },
      "nonbonded": {
        "method": "NoCutoff",
        "cutoff": null,
        "switch_distance": null,
        "use_dispersion_correction": false,
        "ewald_error_tolerance": null,
        "minimum_image_margin": null
      },
      "constraints": "HBonds",
      "rigid_water": false,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true,
      "implicit": {
        "model": "GBn2",
        "radii": "mbondi3"
      }
    },
    "protocol": {
      "schema_version": 6,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "simple",
        "minimize_max_iterations": 1000,
        "seed": null,
        "restrained": "20 ps"
      },
      "production": {
        "method": "rest2",
        "enhanced_region": {
          "type": "solute"
        },
        "tau_ladder": {
          "minimum": 0.0,
          "maximum": 0.5,
          "count": 6,
          "interpolation": "linear"
        },
        "omega_exclusion": {
          "enabled": true,
          "definition": "peptide_omega",
          "proline_like_residues": [
            "PRO"
          ],
          "max_proline_ring_size": 7
        },
        "relaxation": "10 ps",
        "seed": null,
        "duration_per_segment": "5 ns",
        "exchange": {
          "number_of_exchanges_per_segment": 1000
        }
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "100 ps",
        "solute": "10 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  },
  "performance_variant": true
