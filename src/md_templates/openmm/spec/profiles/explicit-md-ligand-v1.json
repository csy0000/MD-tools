{
  "profile_id": "explicit-md-ligand-v1",
  "profile_schema_version": 2,
  "description": "Standard explicit-water conventional MD, ligand/SMILES route",
  "route": "smiles",
  "method": "md",
  "is_default": true,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": "openff-2.2.0",
        "charge_method": "am1bcc",
        "protein": null,
        "water": "amber19/tip3pfb.xml"
      },
      "solvation": {
        "water_model": "tip3p",
        "box_shape": "dodecahedron",
        "padding": "1.2 nm",
        "padding_semantics": "solute-image-gap",
        "ionic_strength_molar": 0.15,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "1.0 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": "3.024 amu",
      "hmr_scope": "solute",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 2,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "4 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "staged",
        "minimize_max_iterations": 0,
        "npt_free": "1000 ps",
        "seed": null
      },
      "production": {
        "method": "md",
        "duration_per_segment": "100 ps",
        "scale_factor": 1.0,
        "seed": null
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "10 ps",
        "solute": "2 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  }
}
