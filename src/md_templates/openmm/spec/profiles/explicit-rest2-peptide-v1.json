{
  "profile_id": "explicit-rest2-peptide-v1",
  "profile_schema_version": 6,
  "description": "Standard explicit-water REST2, peptide/PDB route \u2014 COMPATIBILITY ONLY: TIP3P-FB water. Superseded by explicit-rest2-peptide-v2, which uses OPC. Kept name-resolvable so existing configurations keep resolving to the water model they were run with.",
  "route": "pdb",
  "method": "rest2",
  "is_default": false,
  "defaults": {
    "build": {
      "schema_version": 1,
      "forcefield": {
        "small_molecule": null,
        "charge_method": null,
        "protein": "amber19/protein.ff19SB.xml",
        "water": "amber19/tip3pfb.xml"
      },
      "solvation": {
        "water_model": "tip3p",
        "box_shape": "dodecahedron",
        "padding": "1.2 nm",
        "padding_semantics": "solute-image-gap",
        "ionic_strength_molar": 0.15,
        "positive_ion": "Na+",
        "negative_ion": "Cl-",
        "neutralize": true,
        "cutoff_fit_policy": "grow"
      },
      "nonbonded": {
        "method": "PME",
        "cutoff": "1.0 nm",
        "switch_distance": null,
        "use_dispersion_correction": true,
        "ewald_error_tolerance": 0.0005,
        "minimum_image_margin": "0.10 nm"
      },
      "constraints": "HBonds",
      "rigid_water": true,
      "hydrogen_mass": null,
      "hmr_scope": "none",
      "remove_cm_motion": true
    },
    "protocol": {
      "schema_version": 6,
      "integrator": {
        "kind": "langevin-middle",
        "timestep": "2 fs",
        "temperature": "300 K",
        "friction": "1 /ps"
      },
      "equilibration": {
        "protocol": "staged",
        "minimize_max_iterations": 1000,
        "npt_free": "10 ps",
        "seed": null,
        "nvt": "10 ps",
        "npt": "10 ps"
      },
      "production": {
        "method": "rest2",
        "enhanced_region": {
          "type": "solute"
        },
        "tau_ladder": {
          "minimum": 0.0,
          "maximum": 0.5,
          "count": 6,
          "interpolation": "linear"
        },
        "omega_exclusion": {
          "enabled": true,
          "definition": "peptide_omega",
          "proline_like_residues": [
            "PRO"
          ],
          "max_proline_ring_size": 7
        },
        "relaxation": "10 ps",
        "seed": null,
        "duration_per_segment": "5 ns",
        "exchange": {
          "number_of_exchanges_per_segment": 1000
        }
      }
    },
    "execution": {
      "schema_version": 1,
      "platform": "CPU",
      "device": null,
      "precision": "mixed",
      "reporting": {
        "all_atom": "100 ps",
        "solute": "10 ps",
        "state": "10 ps",
        "checkpoint": "100 ps"
      }
    }
  },
  "superseded_by": "explicit-rest2-peptide-v2"
}
