# md-openmm build-top -- topology and System construction
#
# This file is YAML, despite the .config suffix. Every key below is documented
# with its type, unit, default and consequence. Unknown keys are REFUSED, not
# ignored -- a silently dropped setting produces a run that completes and answers
# a different question than the one you asked.
#
# Topology and System construction for `md-openmm build-top`.
#
# Run it with:
#
#     md-openmm build-top -i INPUT.pdb -os built.xml -op built.pdb -log built.log --config md_build.config
#
# -i takes a FILE: an existing .pdb for a peptide, or a .smi holding exactly one SMILES record
# for a single small molecule. built.pdb and built.xml are a PAIR -- the System's particle order
# matches the PDB exactly, and the build refuses to write either if they disagree.
#
# INCOMPATIBLE COMBINATIONS, all refused rather than ignored:
#
#   * GBn2 is implicit solvent. Setting any box, salt or cutoff key alongside it is an error,
#     because there is no box, no periodic boundary and no ions to configure.
#   * ff19SB was parameterised against OPC water. Pairing it with TIP3P is refused.
#   * A .smi input with solute.peptide true, or a .pdb with solute.peptide false, is refused.
#

# ----------------------------------------------------------------------------------------------
# What the input is, and how it is parameterised.
solute:
  #
  # true reads -i as a peptide/protein PDB and parameterises it with the protein force field.
  # false reads a .smi and parameterises the molecule with the small-molecule force field.
  # Sage never touches a peptide-only input, and the record must not claim it did.
  # [type: bool; default: true]
  peptide: true

  #
  # Small-molecule force field, used only when peptide is false.
  # [type: str; default: sage-2.2.1]
  ligand_forcefield: sage-2.2.1

  #
  # Partial-charge method for the small molecule. am1bcc is the validated default and runs on
  # CPU; it is the slowest part of a ligand build.
  # [type: str; one of: am1bcc, am1bccelf10, gasteiger, nagl; default: am1bcc]
  ligand_charge_method: am1bcc

  #
  # Three-character residue name for a molecule read from .smi. Left null, a deterministic
  # name is assigned from the file and recorded, so the same .smi always produces the same
  # residue identity.
  # [type: str or null; default: null]
  residue_name: null

# ----------------------------------------------------------------------------------------------
# Force-field selection. The resolved resource names are recorded, not these labels.
forcefield:
  #
  # Protein force field. ff19SB is intended to be paired with OPC water; the pairing is
  # checked.
  # [type: str; one of: ff14SB, ff19SB; default: ff14SB]
  protein: ff14SB

# ----------------------------------------------------------------------------------------------
# Solvent treatment. Under GBn2 every key here except `model` is inapplicable.
solvent:
  #
  # TIP3P or OPC give an explicit, periodic, solvated system. GBn2 is IMPLICIT solvent: no
  # water, no box, no ions, no barostat and no NPT stage anywhere downstream. Choosing GBn2
  # changes what the rest of this file may say.
  # [type: str; one of: TIP3P, OPC, GBn2; default: TIP3P]
  model: TIP3P

  #
  # Minimum distance from the solute to the box boundary. The built box may be grown beyond
  # this if the nonbonded cutoff requires it; both the requested and achieved clearances are
  # recorded.
  # [type: float; unit: nm; range: 0.5 .. 5.0; default: 1.5]
  padding_nm: 1.5

  #
  # A rhombic dodecahedron holds ~71% of the water a cube needs for the same clearance, so it
  # is the default. Explicit solvent only.
  # [type: str; one of: dodecahedron, cube, octahedron; default: dodecahedron]
  box_shape: dodecahedron

  #
  # Salt added AFTER neutralising the solute charge, so the final ionic strength is this value
  # and the box is neutral. 0.15 M is physiological.
  # [type: float; unit: mol/L; range: 0.0 .. 2.0; default: 0.15]
  ionic_strength_molar: 0.15

  #
  # Cation used both to neutralise and to reach the ionic strength.
  # [type: str; one of: Na+, K+, Li+, Cs+, Rb+; default: Na+]
  positive_ion: Na+

  #
  # Anion used both to neutralise and to reach the ionic strength.
  # [type: str; one of: Cl-, Br-, F-, I-; default: Cl-]
  negative_ion: Cl-

  #
  # Nonbonded real-space cutoff. The box must be at least twice this in its smallest reduced
  # height; if it is not, the box is grown and that is logged.
  # [type: float; unit: nm; range: 0.6 .. 2.0; default: 1.0]
  cutoff_nm: 1.0

# ----------------------------------------------------------------------------------------------
# Constraints and mass treatment. These change the serialised System.
# ------------------------------------------------------------------------------------------------
# HYDROGEN MASS REPARTITIONING -- an explicit performance option, never a default.
#
# HMR is set HERE, in the system, because it rewrites particle masses in built.xml. The timestep
# that exploits it is set in the protocol config. Each looks reasonable alone; only the PAIR is a
# decision, and a 4 fs timestep is refused at run time unless the serialised System proves the
# masses were actually repartitioned.
#
# To run at 4 fs, all three of these must hold, and then set dynamics.timestep_fs: 4.0 in the
# protocol config:
#
#     constraints.type:              HBonds     bonds to hydrogen must be constrained. HMR lowers
#                                               hydrogen ANGLE frequencies; the bond stretches it
#                                               does not touch are the fastest motions left.
#     constraints.rigid_water:       true       water is never repartitioned, so a flexible water
#                                               keeps its ~10 fs O-H stretch and would set the
#                                               stable timestep for the whole box on its own.
#     constraints.hydrogen_mass_amu: 3.024      each hydrogen is raised to this and its bonded
#                                               heavy atom loses exactly what the hydrogen gained,
#                                               so every heavy-atom/hydrogen group conserves mass.
#
# WHAT IT BUYS, AND WHAT IT COSTS
#
#   buys   roughly a factor of two in wall-clock per nanosecond, with no change to the box, the
#          force field, or the number of particles.
#   costs  the masses are no longer physical. Equilibrium CONFIGURATIONAL averages are unchanged --
#          the Boltzmann distribution in configuration space does not depend on masses -- but time
#          correlation functions, rates, diffusion constants and every other dynamical or transport
#          observable are computed from a system whose inertia has been altered. A short stable
#          smoke run is evidence of stability, not of kinetic validity.
#
# Before using HMR on a system class you have not run before, compare a few hundred picoseconds
# against the 2 fs baseline: total energy drift, temperature, density, and any structural quantity
# you care about. That check belongs to your project, not to this repository.
constraints:
  #
  # HBonds constrains X-H and permits the 2 fs default timestep.
  # [type: str; one of: HBonds, AllBonds, None; default: HBonds]
  type: HBonds

  #
  # Forced to false under implicit solvent, where there is no water to hold rigid.
  # [type: bool; default: true]
  rigid_water: true

  #
  # Hydrogen mass repartitioning. Null (the default) means HMR is NOT applied and the
  # serialised masses are the force field's own. Setting this rewrites particle masses in
  # built.xml, which is a property of the System and cannot be inferred later from a config
  # that merely asks for 4 fs. Whether HMR was applied, the target mass, and a mass summary
  # are all recorded.
  # [type: float or null; unit: amu; range: 1.0 .. 6.0; default: null]
  hydrogen_mass_amu: null
