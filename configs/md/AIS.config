# md-openmm build-md -- AIS (annealed importance sampling)
#
# This file is YAML, despite the .config suffix. Every key is documented with its type, unit,
# default and consequence. Unknown keys are REFUSED, not ignored.
#
# Run it with:
#
#     md-openmm build-md -odir ./md_script/ --config AIS.config
#     cd md_script && ./run.sh ../built.pdb ../built.xml ../hot/whole_prod1.nc
#
# AIS IS NOT PART OF A STAGE CHAIN. Unlike cMD, REST2 and rREST2, it generates no minimisation and
# no equilibration: it CONSUMES an equilibrium ensemble you have already produced. Generating one
# here would run it before its own input existed. `run.sh` therefore takes the source trajectory as
# a required third argument and refuses without it.
#
#
# WHAT A PATH IS
#
# The Hamiltonian is annealed from tau_start to tau_end while the coordinates propagate. It is the
# same REST2 decomposition a fixed-tau cMD walker or a ladder rung uses: solute-solute terms scale
# with (1-tau)^2, solute-environment terms with (1-tau), and torsions about an ordinary amide omega
# bond are left unscaled. The temperature never changes -- this is Hamiltonian switching, not
# temperature annealing.
#
# tau is the ONE public, persisted protocol coordinate. The scale factors are derived from it
# inside the scaler and are deliberately not written to the observation table: a second stored
# coordinate is a second thing that can disagree with the first.
#
#
# THE WORK CONVENTION, STATED ONCE
#
#     delta_W_j = U(tau_{j+1}, x_j) - U(tau_j, x_j)
#
# The parameters move FIRST, at frozen coordinates; the configuration then propagates under the new
# Hamiltonian. Observation 0 is the source configuration under the source Hamiltonian, before any
# parameter change and before any propagation, so its cumulative work is exactly zero by definition
# rather than nearly zero. The last observation is tau_end with the total work of that path.
#
#
# AN OBSERVATION IS NOT A STEP
#
# The defaults below are 50000 integration steps with the Hamiltonian changing every step -- 50000
# parameter changes -- of which 21 points are OBSERVED: both endpoints plus 19 evenly spaced
# interior points, one coordinate frame and one work row each. 50000 / 2500 = 20 intervals, which
# divides exactly. A schedule that would have to be rounded onto the grid is REFUSED, with the
# arithmetic that would fix it.
#
#
# FIXED VOLUME
#
# No barostat is active during switching and no pressure-volume term enters the work, even when the
# source ensemble was NPT. Each path keeps the box of the frame it started from. A prepared System
# carrying a barostat is refused rather than silently switched.
#
#
# WHAT THIS DOES NOT DO
#
#   * Forward only. There is no reverse path and no bidirectional workflow.
#   * NO ESTIMATOR, and no reverse path. Mid-path restart WAS on this list and is not any more:
#     `checkpoint_printout` commits a checkpoint generation, and an interrupted path resumes from
#     the last committed one -- the same path continued, with its accumulated work, its component
#     accumulators and every stream counter restored to one committed instant. A completed path is
#     skipped, after the sha256 of every output its manifest claims has been verified.
#     With `checkpoint_printout: 0` there is nothing to resume from and an interrupted path does
#     restart from its source frame; that is the setting, not a limitation of the method.
#   * A trajectory carries no velocities, so each path draws fresh Maxwell-Boltzmann momenta at the
#     run temperature with its own recorded seed.
#   * NO FREE-ENERGY ESTIMATOR. The work columns are the input a Jarzynski or Crooks analysis would
#     consume. Computing one is not part of this package.

protocol: AIS

# Must match the System `build-top` produced.
solvent: explicit

# ------------------------------------------------------------------------------------------------
# Physical constants and integrator settings. These carry real units.
dynamics:
  # 2.0 fs is the baseline with HBonds constraints and unmodified hydrogen masses. 4.0 fs is
  # refused unless the System proves compatible HMR; see configs/sys/build-top.config.
  timestep_fs: auto
  # The temperature of the source ensemble and of every path. It does not change along the path.
  temperature_K: 300.0
  friction_per_ps: 1.0
  # The base seed. Each path derives its own integrator and velocity seeds from this plus its
  # index, so paths are independent and the whole set is reproducible.
  seed: 1


# ------------------------------------------------------------------------------------------------
# The switching path. EVERY LENGTH IS AN EXACT INTEGER STEP COUNT.
ais:
  # How many independent switching paths. Each gets its own directory, trajectory and seeds.
  # [type: int; range: >= 1; default: 100]
  number_of_paths: 100

  # The tau the path starts at. It must equal the tau of the source ensemble: the path begins in
  # the ensemble it anneals away from.
  # [type: float; range: 0.0 .. 0.95; default: 0.5]
  tau_start: 0.5

  # The tau the path ends at. 0.0 is the unmodified physical Hamiltonian.
  # tau_start and tau_end must differ, or every work value would be zero.
  # [type: float; range: 0.0 .. 0.95; default: 0.0]
  tau_end: 0.0

  # The length of the path, in integration steps. 50000 steps is 100 ps at 2 fs.
  # WORK IS PATH-LENGTH DEPENDENT: a faster switch does more dissipative work. This is a scientific
  # choice, not a performance knob.
  # [type: int; unit: steps; default: 50000]
  switching_steps: 50000

  # How often the path is observed: one coordinate frame and one work row.
  # switching_steps must divide by this exactly, so the last observation lands at tau_end.
  # 50000 / 2500 = 20 intervals -> 21 observations, counting both endpoints.
  # [type: int; unit: steps; default: 2500]
  observation_interval_steps: 2500

  # How often tau moves. 1 changes the Hamiltonian every step.
  # observation_interval_steps must divide by this, or observations would not sit on the update
  # grid and "evenly spaced in tau" would mean evenly spaced after rounding.
  # [type: int; unit: steps; default: 1]
  parameter_update_interval_steps: 1

  # HOW THE WORK IS MEASURED. Two mutually exclusive modes, and the one that decides both what the
  # run costs and what it can be used for afterwards.
  #
  #   work        (DEFAULT) U(tau_k) and U(tau_k+1), subtracted. TWO energy evaluations per
  #               update. You get the work integral for the schedule that actually ran, which is
  #               what a free energy along this schedule needs, and nothing else.
  #
  #   components  the three-group basis probed at amplitudes (0, 0.5, 1), from which the work
  #               follows analytically. THREE evaluations per update. It also gives U as a
  #               FUNCTION of tau -- the identity U(tau) = U_non + (1-tau) U_sqrt + (1-tau)^2
  #               U_lin -- which is what reweighting onto a different schedule, a different
  #               endpoint, or a Hummer-Szabo estimate at an unvisited tau requires.
  #
  # Choose BEFORE the run. A work value cannot be turned back into the function, and re-running at
  # another tau is a new experiment, not a reweighting. A `work` path's tables carry no component
  # columns at all -- absent rather than zero, so a reader that needs them fails instead of
  # treating a measurement nobody took as a measured nought.
  work_measurement: work

  # In `components` mode only: how often the fitted work is also measured directly, as a check on
  # the three-group model. Two extra evaluations whenever it fires.
  #
  #   0 (default) the FIRST update of every path, and no other. The identity is a property of the
  #               SYSTEM rather than of the step -- a force whose tau-dependence falls outside the
  #               basis falls outside it at any coordinate -- so one verified update per path
  #               establishes the model the whole path leans on.
  #   N > 0       every N updates as well, for the case one update cannot cover: a tau-dependence
  #               that only switches on at a geometry the path reaches later.
  verify_every_updates: 0

# ------------------------------------------------------------------------------------------------
# Where the starting configurations come from.
ais_source:
  # REQUIRED. The equilibrium trajectory the paths start from -- typically a fixed-tau cMD run at
  # tau = ais.tau_start, produced by a cMD config with dynamics.tau set. There is no default,
  # because it is data you produced. `run.sh` also takes it as its third argument, which overrides
  # this.
  # [type: str or null; REQUIRED for AIS]
  #
  # The value below is a PLACEHOLDER naming the conventional location, so that this example
  # validates as shipped. Replace it with your own finished run.
  trajectory: ../hot/whole_prod1.nc

  # Topology for reading that trajectory. Null uses the -p topology the run was given, which is the
  # usual case. The resolved choice is recorded either way.
  # [type: str or null; default: null]
  topology: null

  # First eligible frame, INCLUSIVE, as a 0-based index into the trajectory file. A frame index,
  # never a time: the two are interchangeable only when the frame interval is known, and it is not
  # always. Use this to discard equilibration -- for a 2000-frame source, 500 discards the first
  # quarter.
  # [type: int; range: >= 0; default: 0]
  first_frame: 0

  # Last eligible frame, INCLUSIVE. Null means the final frame in the file.
  # [type: int or null; default: null]
  last_frame: null

  # How starting frames are drawn from the eligible window.
  #   uniform_random   drawn with the run's seed; the usual choice
  #   evenly_spaced    taken at a fixed stride, for a deterministic sweep
  # [type: str; one of: uniform_random, evenly_spaced; default: uniform_random]
  selection: uniform_random

  # Whether two paths may start from the SAME frame. False by default: two paths from one
  # configuration are not two independent realisations, and treating them as such understates the
  # spread of the work distribution the method exists to measure. Asking for more paths than the
  # window holds is refused rather than silently reusing frames.
  # [type: bool; default: false]
  allow_repeated_frames: false

# ----------------------------------------------------------------------------------------------
# TORSION COLLECTIVE-VARIABLE REPORTING (v1: torsions only)
#
# OBSERVATION ONLY. No Force is added to the System, no force group is touched, and the
# Hamiltonian, the energies and the dynamics are unchanged. A CV-enabled run is the SAME
# experiment as a CV-disabled one, which is what makes the two comparable; the test suite asserts
# it directly by comparing System serialisation, force inventory, force groups and a single-point
# energy with reporting on and off.
#
# Values are geometric dihedrals in DEGREES, wrapped to [-180, 180) -- half-open, so exactly 180
# reports as -180 and no value has two spellings. Under periodic boundaries the triclinic
# minimum-image convention is applied to the three sequential BOND VECTORS before the dihedral is
# evaluated (not to the four positions independently, which can place two bonded atoms in
# opposite corners). The sign follows the IUPAC/MDTraj convention.
#
# THE INTERVAL IS INDEPENDENT of crd_printout_solute and info_printout, and may be finer than
# either -- that independence is the whole point, since a torsion is cheap to evaluate and a
# frame is expensive to store. Exact schedules are required, and refused rather than rounded:
#
#   cMD     interval_steps divides each dynamics stage's step count
#   REST2   interval_steps divides rest2.exchange_interval_steps
#   rREST2  as REST2
#   AIS     interval_steps is a multiple of ais.parameter_update_interval_steps AND divides
#           ais.switching_steps (tau is piecewise constant across an update, so a row between
#           two updates would report a value against a Hamiltonian the path never held)
#
# Step 0 and the final step are always included, exactly once each. Minimisation produces no
# series: its iterations have no timestep, so a time axis for them would be a fiction.
#
# OUTPUT. UTF-8 CSV, stable columns, no comment lines, plus a JSON sidecar carrying the schema
# version, the original cv.yaml digest, the resolved atom indices, the units, the periodic
# convention and the column order -- so the CSV can be read without the topology or the cv.yaml.
#
#   cMD             <stage>.cv.csv   step,time_ps,trajectory_frame_index,<names>
#   REST2/rREST2    cv_state<i>.csv  step,time_ps,exchange_attempt,state_index,tau,walker_index,
#                                    exchange_phase,trajectory_frame_index,<names>
#   AIS             path_NNNN/cv.csv path_index,source_frame_index,protocol_step,time_ps,tau,
#                                    observation_index,coordinate_frame_index,<names>
#                   AIS_cv.csv       the aggregate, assembled ONLY from paths whose completion
#                                    manifest verified
#
# REST2/rREST2 files follow FIXED THERMODYNAMIC STATES, as the trajectories do: cv_state2.csv holds
# whatever configuration occupied state 2, and walker_index records which walker supplied it.
# Rows on an exchange boundary are PRE-EXCHANGE -- the configuration as propagated, before any
# swap -- so a state's series never contains values from a trajectory that never visited it.
#
# For AIS, observation_index and coordinate_frame_index are EMPTY on rows that do not coincide
# with a saved observation; when present, the values were measured on exactly that saved
# coordinate and never on a neighbouring one.
#
# A path is resolved relative to THIS configuration file and copied, content-addressed, into the
# generated directory, so the generated tree stays movable. On resume the series is truncated to
# the count the checkpoint committed before appending, so a continuation duplicates no row and
# drops none. CV output failures are simulation failures: reporting is never silently disabled.
#
# An example cv.yaml (indices are zero-based; give exactly one of atom_indices or atoms):
#
#     schema_version: 1
#     collective_variables:
#       - name: phi
#         type: torsion
#         atom_indices: [4, 6, 8, 14]
#       - name: psi
#         type: torsion
#         atoms:
#           - {chain: A, residue: "1", atom: N}
#           - {chain: A, residue: "1", atom: CA}
#           - {chain: A, residue: "1", atom: C}
#           - {chain: A, residue: "2", atom: N}
#
# Each entry needs a unique CSV-safe name, type torsion, and either four distinct in-range
# zero-based indices or four selectors that each resolve to EXACTLY ONE atom. An ambiguous
# selector is refused rather than resolved to the first match: a CV series naming the wrong four
# atoms is indistinguishable from one naming the right four.
collective_variables:
  #
  # Path to a cv.yaml, resolved relative to this configuration file. null disables reporting.
  # Giving this without interval_steps is an error, not a default.
  # [type: str or null; default: null]
  file: null

  #
  # Steps between collective-variable observations. 0 disables reporting. Giving this without
  # `file` is an error, not a default.
  # [type: int; unit: steps; range: 0 .. None; default: 0]
  interval_steps: 0
