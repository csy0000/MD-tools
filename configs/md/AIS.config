# md-openmm build-md -- AIS (annealed importance sampling)
#
# This file is YAML, despite the .config suffix. Every key is documented with its type, unit,
# default and consequence. Unknown keys are REFUSED, not ignored.
#
# Run it with:
#
#     md-openmm build-md -odir ./md_script/ --config AIS.config
#     cd md_script && ./run.sh ../built.pdb ../built.xml ../hot/cMD.dcd
#
# AIS IS NOT PART OF A STAGE CHAIN. Unlike cMD, REST2 and rREST2, it generates no minimisation and
# no equilibration: it CONSUMES an equilibrium ensemble you have already produced. Generating one
# here would run it before its own input existed. `run.sh` therefore takes the source trajectory as
# a required third argument and refuses without it.
#
#
# WHAT A PATH IS
#
# The Hamiltonian is annealed from tau_start to tau_end while the coordinates propagate. It is the
# same REST2 decomposition a fixed-tau cMD walker or a ladder rung uses: solute-solute terms scale
# with (1-tau)^2, solute-environment terms with (1-tau), and torsions about an ordinary amide omega
# bond are left unscaled. The temperature never changes -- this is Hamiltonian switching, not
# temperature annealing.
#
# tau is the ONE public, persisted protocol coordinate. The scale factors are derived from it
# inside the scaler and are deliberately not written to the observation table: a second stored
# coordinate is a second thing that can disagree with the first.
#
#
# THE WORK CONVENTION, STATED ONCE
#
#     delta_W_j = U(tau_{j+1}, x_j) - U(tau_j, x_j)
#
# The parameters move FIRST, at frozen coordinates; the configuration then propagates under the new
# Hamiltonian. Observation 0 is the source configuration under the source Hamiltonian, before any
# parameter change and before any propagation, so its cumulative work is exactly zero by definition
# rather than nearly zero. The last observation is tau_end with the total work of that path.
#
#
# AN OBSERVATION IS NOT A STEP
#
# The defaults below are 50000 integration steps with the Hamiltonian changing every step -- 50000
# parameter changes -- of which 21 points are OBSERVED: both endpoints plus 19 evenly spaced
# interior points, one coordinate frame and one work row each. 50000 / 2500 = 20 intervals, which
# divides exactly. A schedule that would have to be rounded onto the grid is REFUSED, with the
# arithmetic that would fix it.
#
#
# FIXED VOLUME
#
# No barostat is active during switching and no pressure-volume term enters the work, even when the
# source ensemble was NPT. Each path keeps the box of the frame it started from. A prepared System
# carrying a barostat is refused rather than silently switched.
#
#
# WHAT THIS DOES NOT DO
#
#   * Forward only. There is no reverse path and no bidirectional workflow.
#   * No mid-path restart. An interrupted path is rerun from its source frame; a completed one is
#     skipped and never appended to. The work integral is only defined along a whole path.
#   * A trajectory carries no velocities, so each path draws fresh Maxwell-Boltzmann momenta at the
#     run temperature with its own recorded seed.
#   * NO FREE-ENERGY ESTIMATOR. The work columns are the input a Jarzynski or Crooks analysis would
#     consume. Computing one is not part of this package.

protocol: AIS

# Must match the System `build-top` produced.
solvent: explicit

# ------------------------------------------------------------------------------------------------
# Physical constants and integrator settings. These carry real units.
dynamics:
  # 2.0 fs is the baseline with HBonds constraints and unmodified hydrogen masses. 4.0 fs is
  # refused unless the System proves compatible HMR; see configs/sys/build-top.config.
  timestep_fs: auto
  # The temperature of the source ensemble and of every path. It does not change along the path.
  temperature_K: 300.0
  friction_per_ps: 1.0
  # The base seed. Each path derives its own integrator and velocity seeds from this plus its
  # index, so paths are independent and the whole set is reproducible.
  seed: 1


# ------------------------------------------------------------------------------------------------
# The switching path. EVERY LENGTH IS AN EXACT INTEGER STEP COUNT.
ais:
  # How many independent switching paths. Each gets its own directory, trajectory and seeds.
  # [type: int; range: >= 1; default: 100]
  number_of_paths: 100

  # The tau the path starts at. It must equal the tau of the source ensemble: the path begins in
  # the ensemble it anneals away from.
  # [type: float; range: 0.0 .. 0.95; default: 0.5]
  tau_start: 0.5

  # The tau the path ends at. 0.0 is the unmodified physical Hamiltonian.
  # tau_start and tau_end must differ, or every work value would be zero.
  # [type: float; range: 0.0 .. 0.95; default: 0.0]
  tau_end: 0.0

  # The length of the path, in integration steps. 50000 steps is 100 ps at 2 fs.
  # WORK IS PATH-LENGTH DEPENDENT: a faster switch does more dissipative work. This is a scientific
  # choice, not a performance knob.
  # [type: int; unit: steps; default: 50000]
  switching_steps: 50000

  # How often the path is observed: one coordinate frame and one work row.
  # switching_steps must divide by this exactly, so the last observation lands at tau_end.
  # 50000 / 2500 = 20 intervals -> 21 observations, counting both endpoints.
  # [type: int; unit: steps; default: 2500]
  observation_interval_steps: 2500

  # How often tau moves. 1 changes the Hamiltonian every step.
  # observation_interval_steps must divide by this, or observations would not sit on the update
  # grid and "evenly spaced in tau" would mean evenly spaced after rounding.
  # [type: int; unit: steps; default: 1]
  parameter_update_interval_steps: 1

# ------------------------------------------------------------------------------------------------
# Where the starting configurations come from.
ais_source:
  # REQUIRED. The equilibrium trajectory the paths start from -- typically a fixed-tau cMD run at
  # tau = ais.tau_start, produced by a cMD config with dynamics.tau set. There is no default,
  # because it is data you produced. `run.sh` also takes it as its third argument, which overrides
  # this.
  # [type: str or null; REQUIRED for AIS]
  #
  # The value below is a PLACEHOLDER naming the conventional location, so that this example
  # validates as shipped. Replace it with your own finished run.
  trajectory: ../hot/cMD.dcd

  # Topology for reading that trajectory. Null uses the -p topology the run was given, which is the
  # usual case. The resolved choice is recorded either way.
  # [type: str or null; default: null]
  topology: null

  # First eligible frame, INCLUSIVE, as a 0-based index into the trajectory file. A frame index,
  # never a time: the two are interchangeable only when the frame interval is known, and it is not
  # always. Use this to discard equilibration -- for a 2000-frame source, 500 discards the first
  # quarter.
  # [type: int; range: >= 0; default: 0]
  first_frame: 0

  # Last eligible frame, INCLUSIVE. Null means the final frame in the file.
  # [type: int or null; default: null]
  last_frame: null

  # How starting frames are drawn from the eligible window.
  #   uniform_random   drawn with the run's seed; the usual choice
  #   evenly_spaced    taken at a fixed stride, for a deterministic sweep
  # [type: str; one of: uniform_random, evenly_spaced; default: uniform_random]
  selection: uniform_random

  # Whether two paths may start from the SAME frame. False by default: two paths from one
  # configuration are not two independent realisations, and treating them as such understates the
  # spread of the work distribution the method exists to measure. Asking for more paths than the
  # window holds is refused rather than silently reusing frames.
  # [type: bool; default: false]
  allow_repeated_frames: false
