# md-openmm build-md -- rREST2
#
# This file is YAML, despite the .config suffix. Every key below is documented
# with its type, unit, default and consequence. Unknown keys are REFUSED, not
# ignored -- a silently dropped setting produces a run that completes and answers
# a different question than the one you asked.
#
# Protocol, stage lengths in steps, and reporting intervals for `md-openmm build-md`.
#
# REST2 with a Boltzmann reservoir refreshing the hottest rung. reservoir.enabled must be true
# and reservoir.path must name a prepared reservoir.
#
# Run it with:
#
#     md-openmm build-md -odir ./md_script/ --config rREST2.config
#
# EVERY LENGTH BELOW IS AN EXACT INTEGER STEP COUNT. A step count is exact; a duration in
# picoseconds depends on a timestep the file may not have been written against. The comments
# show what each count works out to at the default 2 fs timestep, and every stage log prints
# both its step count and the derived physical time -- but the count is what is stored and what
# runs.
#
# Under solvent: implicit the two pressure-coupled equilibration stages are replaced by NVT
# equivalents WITH DIFFERENT FILE NAMES (eq_nvt_posres_2.py, eq_nvt_free.py). They are not NPT
# stages with the pressure quietly ignored: implicit solvent has no box, so there is no volume
# to control and no barostat is added.
#

#
# cMD is plain molecular dynamics. REST2 adds a replica-exchange ladder in which only the
# solute's Hamiltonian is scaled. rREST2 adds a Boltzmann reservoir refresh of the hottest rung.
# [type: str; one of: cMD, REST2, rREST2; default: cMD]
protocol: rREST2

#
# Must match the System `build-top` produced. Under implicit solvent there is no box and no
# barostat, so the pressure-coupled equilibration stages are replaced by honest NVT equivalents
# with different file names -- they are NOT NPT stages with the pressure quietly ignored.
# [type: str; one of: explicit, implicit; default: explicit]
solvent: explicit

# ----------------------------------------------------------------------------------------------
# Physical constants and integrator settings. These carry real units.
# ------------------------------------------------------------------------------------------------
# THE TIMESTEP AND THE SYSTEM ARE ONE DECISION, MADE IN TWO FILES.
#
# timestep_fs: 4.0 is refused at run time unless the System in built.xml actually carries
# repartitioned hydrogen masses. The check is against the masses SERIALISED IN THE SYSTEM, not
# against a configuration that claims HMR: by run time that is a fact rather than a request. See
# the HMR section of configs/sys/build-top.config for the three settings that make 4 fs legitimate
# and for what it costs.
dynamics:
  #
  # `auto` (the default) resolves the timestep when the run opens built.xml and reads the
  # masses actually serialised there: 2.0 fs on ordinary hydrogens, 4.0 fs on repartitioned
  # ones. `build-md` never opens built.xml, so it cannot know whether hydrogen mass
  # repartitioning was applied -- and a configuration CLAIMING it is not evidence.
  #
  # A number may be written instead. It is honoured up to 3.0 fs, and above that only if the
  # System really was repartitioned; 4.0 fs on ordinary hydrogens is refused before anything
  # integrates. The resolved value and its basis are recorded in every stage log.
  # [type: float or 'auto'; unit: fs; range: 0.1 .. 5.0; default: auto]
  timestep_fs: auto

  #
  # Thermostat temperature. Under REST2 every replica runs at this same physical temperature;
  # the ladder scales the Hamiltonian, not the bath.
  # [type: float; unit: K; range: 1.0 .. 1000.0; default: 300.0]
  temperature_K: 300.0

  #
  # Barostat pressure. Ignored -- and refused if a stage claims NPT -- under implicit solvent,
  # which has no volume.
  # [type: float; unit: bar; range: 0.0 .. 1000.0; default: 1.0]
  pressure_bar: 1.0

  #
  # LangevinMiddleIntegrator collision rate.
  # [type: float; unit: 1/ps; range: 0.01 .. 100.0; default: 1.0]
  friction_per_ps: 1.0

  #
  # MonteCarloBarostat volume-move attempt interval, in STEPS. It is the frequency, not the
  # barostat's presence, that makes a stage NPT.
  # [type: int; unit: steps; range: 1 .. None; default: 25]
  barostat_interval_steps: 25

  #
  # Positional restraint on solute heavy atoms during the restrained equilibration stages. A
  # physical constant with real units: the statement that stage LENGTHS are step counts does
  # not make force constants unitless.
  # [type: float; unit: kcal/mol/A^2; range: 0.0 .. 1000.0; default: 1.0]
  restraint_kcal_per_mol_A2: 1.0

  #
  # Fixed REST2 scaling for a cMD run. 0.0 (the default) is the unmodified physical
  # Hamiltonian. A non-zero value runs cMD at ONE rung of the REST2 ladder -- the same scaling
  # the ladder applies, held fixed -- which is how a Boltzmann reservoir for rREST2 is
  # generated, and how a hot ensemble is produced without running an exchange. A scaled run is
  # NVT by construction: it must sample the top rung's fixed-volume ensemble, so a barostat
  # would sample the wrong distribution and is refused.
  # [type: float; range: 0.0 .. 0.95; default: 0.0]
  tau: 0.0

  #
  # Write a phase-space stream (positions, VELOCITIES and box) every N steps. 0 disables it. A
  # reservoir needs complete samples including velocities, which a trajectory does not carry,
  # so this is what a reservoir source is generated with.
  # [type: int; unit: steps; range: 0 .. None; default: 0]
  phase_space_printout: 0

  #
  # Base random seed. Each stage derives its own from this plus the stage name, so stages are
  # independent and the whole chain is reproducible.
  # [type: int; range: 0 .. None; default: 1]
  seed: 1


# ----------------------------------------------------------------------------------------------
# Stage lengths, as exact integer step counts.
stages:
  #
  # Minimiser ITERATIONS, not a time interval: minimisation does not integrate and has no
  # timestep. 0 skips minimisation.
  # [type: int; range: 0 .. None; default: 1000]
  minimization_iterations: 1000

  #
  # Restrained NVT heating/settling. 5000 steps = 10 ps at 2 fs.
  # [type: int; unit: steps; range: 0 .. None; default: 5000]
  restrained_nvt_steps: 5000

  #
  # Restrained NPT density equilibration. 5000 steps = 10 ps at 2 fs. Under implicit solvent
  # this becomes a second restrained NVT stage instead.
  # [type: int; unit: steps; range: 0 .. None; default: 5000]
  restrained_npt_steps: 5000

  #
  # Unrestrained NPT, the last stage before production. 5000 steps = 10 ps at 2 fs. Under
  # implicit solvent this becomes unrestrained NVT.
  # [type: int; unit: steps; range: 0 .. None; default: 5000]
  unrestrained_npt_steps: 5000

  #
  # Production length. 2,500,000 steps = 5 ns at 2 fs. This is the authoritative number; the
  # log prints the derived ps and ns beside it.
  # [type: int; unit: steps; range: 0 .. None; default: 2500000]
  production_steps: 2500000

# ----------------------------------------------------------------------------------------------
# Output intervals, in steps.
reporting:
  #
  # Trajectory output interval. 1000 steps = 2 ps at 2 fs.
  # [type: int; unit: steps; range: 0 .. None; default: 1000]
  solute_printout: 1000

  #
  # Scalar state (energy, temperature, volume, density) interval, written to a CSV beside the
  # log.
  # [type: int; unit: steps; range: 0 .. None; default: 10000]
  system_printout: 10000

  #
  # Checkpoint interval. A checkpoint is what an interrupted stage resumes from, and it is
  # written with a fingerprint of the configuration that produced it so it cannot be resumed
  # under different settings.
  # [type: int; unit: steps; range: 0 .. None; default: 10000]
  checkpoint_printout: 10000

# ----------------------------------------------------------------------------------------------
# The REST2 ladder. Ignored when protocol is cMD. The Hamiltonian scaling itself -- bonds and
# angles unscaled, ordinary amide omega unscaled, eligible solute torsions and CMAP by
# (1-tau)^2, solute-solute nonbonded and 1-4 by (1-tau)^2, solute-environment by (1-tau), GB by
# (1-tau) -- is a property of the validated implementation and is not configurable here.
rest2:
  #
  # States in the ladder. Every state runs at the same physical temperature.
  # [type: int; range: 2 .. 64; default: 4]
  number_of_replicas: 4

  #
  # The hottest rung's tau. The ladder is linear from 0.0 to this value. tau = 0 is the
  # unscaled physical Hamiltonian.
  # [type: float; range: 0.0 .. 0.95; default: 0.5]
  tau_max: 0.5

  #
  # Steps of dynamics between exchange attempts. 5000 steps = 10 ps at 2 fs.
  # [type: int; unit: steps; range: 1 .. None; default: 5000]
  exchange_interval_steps: 5000

  #
  # Exchange attempts. Total production per state is this times exchange_interval_steps.
  # [type: int; range: 1 .. None; default: 500]
  number_of_exchanges: 500

  #
  # Write one trajectory per fixed thermodynamic STATE (remd0.nc .. remdN.nc). A state
  # trajectory follows a state, not a walker; the filename carries the state index and never
  # the tau value.
  # [type: bool; default: true]
  state_trajectory: true

  #
  # Write an Amber-style rem.log projection of the exchange history.
  # [type: bool; default: true]
  rem_log: true

  #
  # Report acceptance for each neighbouring pair. A single averaged acceptance hides a ladder
  # with one impassable gap.
  # [type: bool; default: true]
  neighbour_acceptance_report: true

# ----------------------------------------------------------------------------------------------
# rREST2 reservoir. Ignored unless protocol is rREST2.
reservoir:
  #
  # rREST2 only. Refresh the hottest rung from a pre-generated Boltzmann reservoir instead of
  # propagating it.
  # [type: bool; default: false]
  enabled: true

  #
  # Reservoir directory. Required when enabled.
  # [type: str or null; default: null]
  path: ./reservoir

  #
  # How often the hottest rung is refreshed from the reservoir, in exchange attempts.
  # [type: int; range: 1 .. None; default: 1]
  refresh_interval_exchanges: 1

  #
  # Where a refreshed configuration's velocities come from. `resample` draws them from the
  # Maxwell-Boltzmann distribution at the run temperature; `inherit` keeps the reservoir's
  # own. Recorded explicitly because it is a provenance question, not a tuning knob.
  # [type: str; one of: resample, inherit; default: resample]
  velocities: resample

# ----------------------------------------------------------------------------------------------
# TORSION COLLECTIVE-VARIABLE REPORTING (v1: torsions only)
#
# OBSERVATION ONLY. No Force is added to the System, no force group is touched, and the
# Hamiltonian, the energies and the dynamics are unchanged. A CV-enabled run is the SAME
# experiment as a CV-disabled one, which is what makes the two comparable; the test suite asserts
# it directly by comparing System serialisation, force inventory, force groups and a single-point
# energy with reporting on and off.
#
# Values are geometric dihedrals in DEGREES, wrapped to [-180, 180) -- half-open, so exactly 180
# reports as -180 and no value has two spellings. Under periodic boundaries the triclinic
# minimum-image convention is applied to the three sequential BOND VECTORS before the dihedral is
# evaluated (not to the four positions independently, which can place two bonded atoms in
# opposite corners). The sign follows the IUPAC/MDTraj convention.
#
# THE INTERVAL IS INDEPENDENT of solute_printout and system_printout, and may be finer than
# either -- that independence is the whole point, since a torsion is cheap to evaluate and a
# frame is expensive to store. Exact schedules are required, and refused rather than rounded:
#
#   cMD     interval_steps divides each dynamics stage's step count
#   REST2   interval_steps divides rest2.exchange_interval_steps
#   rREST2  as REST2
#   AIS     interval_steps is a multiple of ais.parameter_update_interval_steps AND divides
#           ais.switching_steps (tau is piecewise constant across an update, so a row between
#           two updates would report a value against a Hamiltonian the path never held)
#
# Step 0 and the final step are always included, exactly once each. Minimisation produces no
# series: its iterations have no timestep, so a time axis for them would be a fiction.
#
# OUTPUT. UTF-8 CSV, stable columns, no comment lines, plus a JSON sidecar carrying the schema
# version, the original cv.yaml digest, the resolved atom indices, the units, the periodic
# convention and the column order -- so the CSV can be read without the topology or the cv.yaml.
#
#   cMD             <stage>.cv.csv   step,time_ps,trajectory_frame_index,<names>
#   REST2/rREST2    remd<N>.cv.csv   step,time_ps,exchange_attempt,state_index,tau,walker_index,
#                                    exchange_phase,trajectory_frame_index,<names>
#   AIS             path_NNNN/cv.csv path_index,source_frame_index,protocol_step,time_ps,tau,
#                                    observation_index,coordinate_frame_index,<names>
#                   AIS_cv.csv       the aggregate, assembled ONLY from paths whose completion
#                                    manifest verified
#
# REST2/rREST2 files follow FIXED THERMODYNAMIC STATES, as the trajectories do: remd2.cv.csv holds
# whatever configuration occupied state 2, and walker_index records which walker supplied it.
# Rows on an exchange boundary are PRE-EXCHANGE -- the configuration as propagated, before any
# swap -- so a state's series never contains values from a trajectory that never visited it.
#
# For AIS, observation_index and coordinate_frame_index are EMPTY on rows that do not coincide
# with a saved observation; when present, the values were measured on exactly that saved
# coordinate and never on a neighbouring one.
#
# A path is resolved relative to THIS configuration file and copied, content-addressed, into the
# generated directory, so the generated tree stays movable. On resume the series is truncated to
# the count the checkpoint committed before appending, so a continuation duplicates no row and
# drops none. CV output failures are simulation failures: reporting is never silently disabled.
#
# An example cv.yaml (indices are zero-based; give exactly one of atom_indices or atoms):
#
#     schema_version: 1
#     collective_variables:
#       - name: phi
#         type: torsion
#         atom_indices: [4, 6, 8, 14]
#       - name: psi
#         type: torsion
#         atoms:
#           - {chain: A, residue: "1", atom: N}
#           - {chain: A, residue: "1", atom: CA}
#           - {chain: A, residue: "1", atom: C}
#           - {chain: A, residue: "2", atom: N}
#
# Each entry needs a unique CSV-safe name, type torsion, and either four distinct in-range
# zero-based indices or four selectors that each resolve to EXACTLY ONE atom. An ambiguous
# selector is refused rather than resolved to the first match: a CV series naming the wrong four
# atoms is indistinguishable from one naming the right four.
collective_variables:
  #
  # Path to a cv.yaml, resolved relative to this configuration file. null disables reporting.
  # Giving this without interval_steps is an error, not a default.
  # [type: str or null; default: null]
  file: null

  #
  # Steps between collective-variable observations. 0 disables reporting. Giving this without
  # `file` is an error, not a default.
  # [type: int; unit: steps; range: 0 .. None; default: 0]
  interval_steps: 0
