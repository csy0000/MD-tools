  skeleton_digest: caf1a773da64b45bf3e3177b2585d3fe2ebfbbe35f889afdcc4d4598454339b2
  skeleton_smiles: CC(O)O
  standard_inchikey_skeleton: QTBSBXVTEAMEQO
