protonation:
  canonical_smiles: '[H]c1nc(N([H])C(=O)C([H])([H])C([H])([H])[H])c([H])c(N([H])C(=O)c2c(Cl)c([H])c([H])c([H])c2Cl)c1[H]'
  digest: 6a88d0b4f80d04f01c9a7241aac8523ce1458441944d0a3ced945c4b46198183
  fixed_h_inchikey: CEJFWHOOEUEYOE-NPVYFSBINA-N
