  digest: b5ceb0dd55517650985e4ecbca58d3280739310ce6e342ac925d6b5a36bfd7f8
  fixed_h_inchikey: OFBQJSOFQDEBGM-UHFFFAOYNA-N
  net_formal_charge: 0
