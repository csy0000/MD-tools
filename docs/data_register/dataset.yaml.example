# dataset.yaml -- the manifest `md-openmm data-register` WRITES into a registered dataset.
#
# This file is documentation. You do not hand-write it: registration derives it from the machine
# records inside the directory being registered, and hand-editing a registered manifest breaks the
# checksums that make the dataset verifiable. It is reproduced here so you can see what will be
# written before you run the command.
#
# The authoritative schema is docs/data-contract.md and the generated
# dataset-v2.0.schema.json that ships with the package.

schema_version: "2.0"

# Derived from the canonical path. Stable for the life of the dataset.
dataset_id: "2026/ALA/ALA-cMD"
path: "2026/ALA/ALA-cMD"

# The YEAR the dataset was COMPLETED, not the month it was started. There is no month segment.
year: "2026"
project_name: "ALA"
data_name: "ALA-cMD"

# `project` -> $MD_DATA/{year}/{project_name}/{data_name}/
# `common`  -> $MD_DATA/common/{year}/{project_name}/{data_name}/
role: project

# What was simulated, in one line a human can read.
system: "Alanine dipeptide, ff14SB + TIP3P, rhombic dodecahedron, 1.5 nm padding"

created_at: "2026-09-02T10:15:00Z"
completed_at: "2026-09-02T18:42:11Z"

# Taken from your user configuration; see user.config.example beside this file.
created_by:
  person_id: "your-name-here"
  name: "Your Name"
  orcid: null
  affiliation: null

# active -> still being written; complete -> finished and immutable; archived -> retired.
# Registration refuses anything that is not finished.
status: complete

# The exact code that produced this. A branch name is not provenance; the 40-hex commit is.
origin:
  repository: "https://github.com/csy0000/MD-tools"
  commit: "0000000000000000000000000000000000000000"
  version: "0.5.0.dev0"

# One entry per directory of output. `linked: true` means the component is a symlink into a parent
# dataset rather than its own bytes -- see extension.yaml.example.
components:
  - name: "cMD"
    type: simulation
    method: "cMD"
    path: "cMD"
    status: complete
    linked: false
    description: "5 ns NPT production, 2 fs, ff14SB/TIP3P"
  - name: "inputs"
    type: shared-input
    path: "inputs"
    status: complete
    linked: false
    description: "built.pdb, built.xml and the build record"

# Empty unless this dataset continues another one; then it lists the parents by dataset_id.
derived_from: []

notes: null
