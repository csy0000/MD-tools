# A minimal, runnable umbrella-sampling configuration.
#
#   md-openmm build-md -odir ./md_script/ --config example.config
#   cd md_script && ./run.sh ../built.pdb ../built.xml
#
# What a run WRITES -- the `.out` census (System / Method / Selections) and the
# per-term energy decomposition -- is documented at the foot of
# configs/md/cMD.config; umbrella writes a cMD stage's outputs, plus the biases.
#
# Umbrella sampling here is conventional MD with biases: the same minimisation and equilibration
# chain runs first, and the production stage carries the restraints. One window per run -- to
# build a profile, run this once per centre and reweight the series afterwards.
#
# WHAT THIS PROTOCOL DOES NOT DO: turn windows into a free energy. WHAM and MBAR are ANALYSIS and
# live in the project asking the question, not in the engine generating the samples. What you get
# here is the biased series and the restraint that produced it, which is what an estimator needs.

protocol: umbrella
solvent: implicit

# No `seed` here. It is the one setting that is per RUN rather than per method -- every repeat of
# one method on one system reads the same input and differs only in its seed -- so it lives in a
# `run.config` beside the run, not in a shared configuration. See docs/run-layout.md.
dynamics: {timestep_fs: 2.0, temperature_K: 300.0}

stages:
  minimization_iterations: 100
  restrained_nvt_steps: 500
  restrained_npt_steps: 500
  unrestrained_npt_steps: 500
  # 10 ps at 2 fs. An example length, not a converged one: a window needs long enough for the
  # restrained variable to decorrelate, and that is a property of the system, not of this file.
  production_steps: 5000

reporting: {crd_printout_solute: 500, info_printout: 500, checkpoint_printout: 1000}

# BOTH are required for umbrella sampling, and they are required together. The restraint resolves
# its `cv` name against this file, and the same file drives the series that gets reported -- so a
# window that biased a variable and never recorded it would produce a trajectory nobody can
# reweight. Reporting every 100 steps = every 200 fs.
collective_variables: {file: cv.yaml, interval_steps: 100}

# The restraints themselves. A path, not an inline list: see `umbrella.yaml` beside this file.
umbrella: {file: umbrella.yaml}
