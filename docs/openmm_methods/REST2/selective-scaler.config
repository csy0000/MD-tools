# Selective REST2: a scaler.config that heats part of the solute (0.6.1, in development).
#
#   md-openmm build-top -i ALA.pdb -os build/built.xml -op build/built.pdb -log build/built.log
#   cp selective-scaler.config build/scaler.config
#   md-openmm build-top --rest2-scaler -s build/built.xml -p build/built.pdb --config build/scaler.config
#
# Written for ACE-ALA-NME (tests/data/ALA.pdb): residue 1 is ACE, 2 is ALA and 3 is NME, and the
# water and ions a build adds come after them. `scaler.log` prints this map as resolved, so
# check it there before running anything.
#
# Any selector key present makes the selection EXPLICIT: only what is named is hot, and an
# omitted category means none. With no selector at all, the whole solute is hot, exactly as in
# 0.6.0. Masks are quoted, and numbered by one-based topology residue index.

method: REST2
schedule:
  kind: linear
  n_states: 4
  tau_min: 0.0
  tau_max: 0.5

# ALA's backbone: phi (N-CA) and psi (CA-C), which under ff14SB carry torsion terms and under
# ff19SB live in CMAP, plus the nonbonded factors on N, H, CA, HA, C and O.
backbone_scaling_list: ":2"

# ALA's sidechain: CB and its hydrogens, and chi1 (CA-CB).
sidechain_scaling_list: ":2"

# A ligand is selected per COPY, one residue per entry, for example:
#
# ligand_scaling_dict:
#   L01:
#     mask: ":201"
#     torsion_exclusions: auto      # or an md-tools-torsion-exclusions/1 file
#
# ALA has no ligand, so this example leaves the key out: the ligand category is then empty.
