# A minimal, runnable REST2 configuration.
#
# Every accepted key is documented in docs/md-configuration.md. The canonical example at the
# model's own defaults is configs/md/REST2.config at the
# repository root. This one shows the handful you normally set.
#
# What a run WRITES -- the `.out` census (System / Method / Selections), the per-term
# energy decomposition, and the ladder's Hamiltonian identity, per-state filenames
# and timings -- is documented at the foot of configs/md/REST2.config.
#
#   md-openmm build-md -odir ./md_script/ --config example.config

protocol: REST2
solvent: explicit

rest2:
  # Four states from tau = 0 to tau = 0.5. State 0 is always the unmodified physical Hamiltonian.
  number_of_replicas: 4
  tau_max: 0.5
  # Exchange every 5000 steps, 100 times: a short ladder that finishes while you watch.
  exchange_interval_steps: 5000
  number_of_exchanges: 100

stages:
  # The equilibration chain the ladder starts from.
  minimization_iterations: 1000
  restrained_nvt_steps: 5000
  restrained_npt_steps: 5000
  unrestrained_npt_steps: 5000

reporting:
  crd_printout_solute: 500
  info_printout: 5000
  checkpoint_printout: 5000
