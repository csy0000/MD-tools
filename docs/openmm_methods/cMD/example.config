# A minimal, runnable cMD configuration.
#
# Minimal on purpose: every key not written here is resolved from the model's own defaults, and
# `build-md.log` records which. The canonical example at the model's own defaults is
# configs/md/cMD.config; every accepted key is documented in docs/md-configuration.md
# at the repository root -- that one documents every accepted key; this one shows the few you
# usually set.
#
# What a run WRITES -- the `.out` census (System / Method / Selections) and the
# per-term energy decomposition -- is documented at the foot of configs/md/cMD.config.
#
#   md-openmm build-md -odir ./md_script/ --config example.config

protocol: cMD
solvent: explicit

stages:
  # Integer step counts, always. At 2 fs these are 20 ps of equilibration and 200 ps of production
  # -- small enough to finish while you watch, which is what makes this an example and not a
  # production input.
  minimization_iterations: 1000
  restrained_nvt_steps: 5000
  restrained_npt_steps: 5000
  unrestrained_npt_steps: 5000
  production_steps: 100000

reporting:
  crd_printout_solute: 500
  info_printout: 5000
  checkpoint_printout: 5000
