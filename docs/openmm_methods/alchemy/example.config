# A minimal alchemical topology configuration.
#
#   md-openmm combine-topology --config example.config -odir ./plan --check
#   md-openmm combine-topology --config example.config -odir ./plan
#
# UNDER CONSTRUCTION (0.7.0). A plan is not consumed by any downstream command: there is no
# `protocol: alchemical` in build-md. What this writes is a plan directory for the Python API --
# plan.json, system_a.xml, system_b.xml, combined.pdb, positions.npy -- not a runnable campaign.
#
# Every path here is RELATIVE to this file. Nothing in a committed configuration names a machine,
# a user or an absolute path.

format: md-tools-combine-topology/1

# single: one evolving atom representation, every atom of one endpoint mapped, a mapped atom may
#         change element.
# hybrid: a mapped core plus endpoint-unique atoms on both sides. A hydrogen is never mapped to a
#         heavy atom.
# dual:   the two ligands share no particle; B is appended whole, every A-B pair excluded, and a
#         harmonic restraint between the mapped centroids keeps the dummy ligand with the
#         physical one.
# `separated` is deferred beyond 0.7.0 and refused by name -- it is not partially supported.
mode: hybrid

# The two ligand parameter packages, by `<compound-id>/param_<parameter-id>` reference or by
# package path. Their parameters are used EXACTLY as registered; nothing is reparameterised, and
# an environment whose ligand does not carry package A's parameters is refused rather than
# adjusted. Each endpoint accepts exactly one key, `parameters`. The two references below are
# illustrative: substitute the packages your own build-top registered.
endpoints:
  A: {parameters: LOCAL-DKNAYSZNMZIMIZ/param_bd1388e5fe3e}   # the endpoint the environment holds
  B: {parameters: LOCAL-QKZCVJXDNCLXGL/param_4f1c9ab7e206}   # the endpoint it becomes

# ONE matched environment: a built System, its topology, and the build-top record that made them.
# Endpoint B never gets its own box -- two independently solvated boxes are not atom-matched.
#
# The record is not optional and not decorative. Its `outputs` sha256 for both files are checked
# against the files given, so a record describing another build is refused; it supplies the 1-4
# scales the System APPLIES to the ligand (`nonbonded_compatibility`, recorded by build-top since
# 0.6.0), which are never inferred; and its `solvent.treatment` supplies the solvation, which is
# never inferred from periodicity -- a vacuum leg and an implicit-solvent System are both
# non-periodic.
environment:
  system: build/built.xml
  topology: build/built.pdb
  record: build/built.log
  # Exactly ONE residue, and its atoms must be package A's names and elements in package order --
  # otherwise it is not endpoint A. `{chain, resid, insertion_code}` selects the other way.
  ligand: {resname: LIG}

# Exactly one of `file` and `automatic: true`; neither, or both, is refused.
#
# `file` is either `pairs: [[a, b], ...]` in package-local atom names or indices, or an atom-map
# record as combine-topology writes it -- re-verified in full, so an edited record is refused
# rather than trusted.
#
# `automatic: true` proposes one (rdkit-fmcs-heavy/1) and writes it BESIDE the plan, as
# <odir>.map.yaml, for review; handed back here as `file:` it reproduces the same plan_sha256. It
# refuses a chemically ambiguous proposal -- two maps of the same size that validate and are not
# related by a symmetry of either molecule would be two DIFFERENT transformations, and both would
# run. It is refused outright for mode: single, where a mapped atom may change element and the
# correspondence is stated, not guessed.
map: {file: core.map.yaml}

# mode: dual ONLY -- it is the restraint that keeps the two dual-topology ligands together, and no
# other mode has one, so setting it here under `hybrid` would be refused. Left unset, the
# builder's default (1000 kJ/mol/nm^2) applies.
# dual: {restraint_k_kj_mol_nm2: 1000.0}

# Searched FIRST for `<compound>/param_<id>` references, before $MD_DATA/parameters/ligands. It
# stays in the configuration as written and is resolved against THIS file when the catalog is
# searched, so no record carries this machine's absolute path.
ligand_catalog: {path: build/ligands}

# Endpoint B's pose, as an .sdf in B's chemical state; its atoms are put into package order by the
# ligand module's own matcher, which refuses a different molecule rather than guessing. Left
# unset, package B's reference conformer is superposed on the mapped A atoms and the core RMSD of
# that fit is recorded in plan.json.
# b_pose: docked_b.sdf
