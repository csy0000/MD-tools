# A minimal, runnable AIS configuration.
#
# AIS needs a SOURCE ENSEMBLE that already exists: a fixed-tau cMD run at ais.tau_start. See the
# README beside this file. The canonical example at the model's defaults is
# configs/md/AIS.config; every accepted key is documented in docs/md-configuration.md.
#
# What a run WRITES -- the `.out` census (System / Method / Selections), the per-term
# energy decomposition, and the work table with its two probes and work convention --
# is documented at the foot of configs/md/AIS.config.
#
#   md-openmm build-md -odir ./md_script/ --config example.config
#   cd md_script && ./run.sh ../built.pdb ../built.xml ../hot/whole_prod1.nc

protocol: AIS
solvent: explicit

ais:
  # Ten short paths: enough to see a work distribution form, far too few to average over.
  number_of_paths: 10
  tau_start: 0.5
  tau_end: 0.0
  # 5000 steps is 10 ps at 2 fs. Work is path-length dependent -- this is an example length, not a
  # converged one.
  switching_steps: 5000
  observation_interval_steps: 500
  # How the work is measured, and the dominant cost of the run. `work` is the default: two energy
  # evaluations per update, giving the work integral for the schedule that ran. Change it to
  # `components` BEFORE the run if you will want to reweight onto a tau this path never visits --
  # that needs the potential as a function of tau, which a work value cannot be turned back into.
  work_measurement: work

ais_source:
  # The equilibrium ensemble at tau = 0.5. Resolved relative to where run.sh is invoked.
  trajectory: ../hot/whole_prod1.nc
