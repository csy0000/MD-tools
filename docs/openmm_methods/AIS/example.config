# A minimal, runnable AIS configuration.
#
# AIS transforms one end state into another, V(lambda) = (1 - lambda) V0 + lambda V1, and needs a
# SOURCE ENSEMBLE of V0 that already exists. V0 and V1 are files given to md-run as -s/-p and
# -s2/-p2; they are not configuration. See the README beside this file. The canonical example at the model's defaults is
# configs/md/AIS.config; every accepted key is documented in docs/md-configuration.md.
#
# What a run WRITES -- the `.out` census (System / Method / Selections), the per-term
# energy decomposition, and the work table with its two probes and work convention --
# is documented at the foot of configs/md/AIS.config.
#
#   md-openmm build-md -odir ./AIS-run1 --config example.config
#   cd AIS-run1 && ./run.sh V0.pdb V0.xml ../hot/whole_prod1.nc      # V1 defaults to ../build/built.*

protocol: AIS
solvent: explicit

ais:
  # Ten short paths: enough to see a work distribution form, far too few to average over.
  number_of_paths: 10
  # 5000 steps is 10 ps at 2 fs. Work is path-length dependent -- this is an example length, not a
  # converged one.
  switching_steps: 5000
  observation_interval_steps: 500

ais_source:
  # An equilibrium ensemble of V0. Resolved relative to where run.sh is invoked.
  trajectory: ../hot/whole_prod1.nc
