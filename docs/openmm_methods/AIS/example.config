# A minimal, runnable AIS configuration.
#
# AIS needs a SOURCE ENSEMBLE that already exists: a fixed-tau cMD run at ais.tau_start. See the
# README beside this file. The comprehensive example is configs/md/AIS.config.
#
#   md-openmm build-md -odir ./md_script/ --config example.config
#   cd md_script && ./run.sh ../built.pdb ../built.xml ../hot/cMD.dcd

protocol: AIS
solvent: explicit

ais:
  # Ten short paths: enough to see a work distribution form, far too few to average over.
  number_of_paths: 10
  tau_start: 0.5
  tau_end: 0.0
  # 5000 steps is 10 ps at 2 fs. Work is path-length dependent -- this is an example length, not a
  # converged one.
  switching_steps: 5000
  observation_interval_steps: 500

ais_source:
  # The equilibrium ensemble at tau = 0.5. Resolved relative to where run.sh is invoked.
  trajectory: ../hot/cMD.dcd
