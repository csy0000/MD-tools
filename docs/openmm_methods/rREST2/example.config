# A minimal, runnable rREST2 configuration.
#
# rREST2 needs a reservoir that ALREADY EXISTS, generated by a fixed-tau cMD run at this ladder's
# tau_max with dynamics.phase_space_printout set. See the README beside this file; the
# comprehensive example is configs/md/rREST2.config.
#
#   md-openmm build-md -odir ./md_script/ --config example.config

protocol: rREST2
solvent: explicit

rest2:
  number_of_replicas: 4
  tau_max: 0.5
  exchange_interval_steps: 5000
  number_of_exchanges: 100

reservoir:
  enabled: true
  # A phase-space file from a tau = 0.5 cMD run. Relative to the directory run.sh is invoked from.
  path: ../hot/cMD.phase_space.nc
  refresh_interval_exchanges: 1
  # `inherit` installs the recorded momenta, which is what probability-one acceptance assumes.
  velocities: inherit

stages:
  minimization_iterations: 1000
  restrained_nvt_steps: 5000
  restrained_npt_steps: 5000
  unrestrained_npt_steps: 5000

reporting:
  crd_printout_solute: 500
  info_printout: 5000
  checkpoint_printout: 5000
