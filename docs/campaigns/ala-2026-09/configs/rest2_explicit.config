protocol: REST2
solvent: explicit
dynamics: {timestep_fs: 2.0, temperature_K: 300.0, seed: 1}
stages: {minimization_iterations: 1000, restrained_nvt_steps: 5000, restrained_npt_steps: 5000, unrestrained_npt_steps: 0, production_steps: 0}
reporting: {crd_printout_solute: 2500, crd_printout_whole: 25000000, info_printout: 50000, checkpoint_printout: 500000}
rest2: {number_of_replicas: 6, tau_max: 0.5, exchange_interval_steps: 5000, number_of_exchanges: 30000}
