protocol: cMD
solvent: explicit
dynamics: {timestep_fs: 2.0, temperature_K: 300.0, seed: 1, tau: 0.0}
stages: {minimization_iterations: 1000, restrained_nvt_steps: 5000, restrained_npt_steps: 5000, unrestrained_npt_steps: 0, production_steps: 500000}
reporting: {crd_printout_solute: 2500, crd_printout_whole: 5000, info_printout: 5000, checkpoint_printout: 50000}
