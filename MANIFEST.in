# The canonical catalog and the build hook must travel in an sdist, or a wheel built from that
# sdist would have nothing to package and no way to validate it.
include registry.yaml
recursive-include templates *.yaml
recursive-include build_support *.py
include setup.py
include CHANGELOG.md
include environment-ci.yml

# The public entry points and the worked examples. A consuming project that installs an sdist should
# be able to read how the generators are meant to be driven, not just import the package.
include MD_system_gen.py
include MD_input_gen.py
recursive-include test *.json *.md *.smi *.pdb
